#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# Nixpkgs can provide a newer pnpm than package.json pins. Keep the executable
# from the active environment instead of downloading a generic Linux binary.
export NPM_CONFIG_MANAGE_PACKAGE_MANAGER_VERSIONS="${NPM_CONFIG_MANAGE_PACKAGE_MANAGER_VERSIONS:-false}"

usage() {
  cat <<'EOF'
Java Blueprints commands (run from the repository root):

  ./dev api           Start API on :3000 (uses local parser JAR if built)
  ./dev web-install   Install frontend dependencies
  ./dev web           Start Next.js on :3001
  ./dev parser-build  Build the Java parser CLI
  ./dev runner-build  Build the isolated Java 21 runner image
  ./dev runner-test   Run the opt-in real-container verification test
  ./dev up            Install project deps, build, and start the app
  ./dev api-check     Run Rust format and compile checks
  ./dev api-test      Run Rust tests
  ./dev demo          Scripted end-to-end run (needs parser JAR, Docker, runner image); writes docs/evidence/demo/
  ./dev web-fast-check Run frontend typecheck and lint
  ./dev web-check     Run frontend lint and production build
EOF
}

run_in() {
  local directory="$1"
  shift
  cd "$ROOT/$directory"
  exec "$@"
}

require_tools() {
  local missing=""
  local tool
  for tool in cargo java mvn node pnpm; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      missing="$missing $tool"
    fi
  done
  if [[ -n "$missing" ]]; then
    printf 'Missing required tools:%s\nInstall them using the instructions in README.md.\n' "$missing" >&2
    exit 1
  fi
}

ensure_runner() {
  local image="java-blueprints-runner:java21"
  if [[ -n "${BLUEPRINTS_RUNNER_IMAGE:-}" ]]; then
    return 0
  fi
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    if ! docker image inspect "$image" >/dev/null 2>&1; then
      printf 'Building isolated Java runner image (%s)...\n' "$image"
      docker build -t "$image" "$ROOT/apps/runner"
    fi
    export BLUEPRINTS_RUNNER_IMAGE="$image"
  else
    printf 'Docker is not available or daemon is not running; behavioral verification will be disabled.\n' >&2
  fi
}

command="${1:-help}"
case "$command" in
  api)
    parser_jar="$ROOT/apps/parser/target/ASTPARSER-1.0-SNAPSHOT.jar"
    if [[ -z "${BLUEPRINTS_ANALYZER_JAR:-}" && -f "$parser_jar" ]]; then
      export BLUEPRINTS_ANALYZER_JAR="$parser_jar"
    elif [[ -z "${BLUEPRINTS_ANALYZER_JAR:-}" ]]; then
      printf 'Parser JAR not built; analysis will be unavailable. Run ./dev parser-build first.\n' >&2
    fi
    ensure_runner
    run_in apps/api cargo run
    ;;
  web-install)
    run_in apps/web pnpm install
    ;;
  web)
    run_in apps/web pnpm dev
    ;;
  parser-build)
    run_in apps/parser mvn package
    ;;
  runner-build)
    exec docker build -t java-blueprints-runner:java21 "$ROOT/apps/runner"
    ;;
  runner-test)
    export BLUEPRINTS_REAL_RUNNER_IMAGE="${BLUEPRINTS_REAL_RUNNER_IMAGE:-java-blueprints-runner:java21}"
    run_in apps/api cargo test api::tests::real_container_http_verification -- --ignored --exact --nocapture
    ;;
  up)
    require_tools
    printf 'Installing frontend dependencies...\n'
    (cd "$ROOT/apps/web" && pnpm install --frozen-lockfile)
    printf 'Building Java parser...\n'
    (cd "$ROOT/apps/parser" && mvn -DskipTests package)
    printf 'Building Rust API...\n'
    (cd "$ROOT/apps/api" && cargo build)

    parser_jar="$ROOT/apps/parser/target/ASTPARSER-1.0-SNAPSHOT.jar"
    if [[ -z "${BLUEPRINTS_ANALYZER_JAR:-}" ]]; then
      export BLUEPRINTS_ANALYZER_JAR="$parser_jar"
    fi

    ensure_runner

    printf '\nAPI: http://localhost:3000\nWeb: http://localhost:3001\nPress Ctrl+C to stop both.\n\n'
    cd "$ROOT/apps/web"
    exec pnpm exec concurrently --kill-others --names api,web --prefix-colors blue,green \
      'cd ../api && cargo run' 'pnpm dev'
    ;;
  api-check)
    cd "$ROOT/apps/api"
    cargo fmt --check
    cargo check
    ;;
  api-test)
    run_in apps/api cargo test
    ;;
  api-e2e)
    # needs the parser JAR (./dev parser-build); no Docker
    run_in apps/api cargo test --test e2e_import --test e2e_analysis --test e2e_edit
    ;;
  demo)
    # scripted end-to-end run against the real parser, API and Docker runner; writes docs/evidence/demo/
    shift
    exec python3 "$ROOT/scripts/demo.py" "$@"
    ;;
  api-e2e-docker)
    # needs the parser JAR, a running Docker daemon and the runner image (./dev runner-build)
    run_in apps/api cargo test --test docker_e2e -- --ignored
    ;;
  web-fast-check)
    cd "$ROOT/apps/web"
    pnpm exec tsc --noEmit
    pnpm lint
    ;;
  web-check)
    cd "$ROOT/apps/web"
    pnpm exec tsc --noEmit
    pnpm lint
    pnpm build
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac
